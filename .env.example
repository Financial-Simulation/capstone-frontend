# 복사해서 .env.local로 쓰세요:  cp .env.example .env.local
# (.env.local은 깃에 올라가지 않아요. 바꾼 뒤에는 npm run dev를 다시 켜야 적용돼요)

# 개발 프록시가 /api/* 를 넘길 백엔드 주소 (next.config.ts의 rewrites)
BACKEND_URL=http://localhost:8080

# API 목업 스위치 (엔드포인트별 mock / real). 비워 두면 기본값:
#   validate · repaymentPreview · presets · examples = real (백엔드에 있음)
#   simulate · preview · compare · reverse · robust · meta = mock (정답 파일 analysis_golden.json)
# 예) 전부 목업 (백엔드 없이 화면만 볼 때):  NEXT_PUBLIC_API_MODE=all-mock
#     simulate만 실제로:                    NEXT_PUBLIC_API_MODE=simulate=real
#     섞어서:                               NEXT_PUBLIC_API_MODE=all-mock,validate=real
# 브라우저에서 바로 바꾸려면 http://localhost:3000/dev (새로고침해도 유지, 이 값보다 우선)
NEXT_PUBLIC_API_MODE=
